# Claude worktrees and other local tooling state.
.claude/

# A host venv, at any depth, must not shadow the one built inside the image.
**/.venv/

# Exact-patch pin (e.g. 3.14.5) a base image's uv may not fetch; requires-python (>=3.14,<3.15)
# is satisfied by any 3.14.x, so let uv use the base image's own.
.python-version

# Secrets: supply .env at runtime, never bake it into the image. `*.env` matches any env file
# but not the `*.env.example` templates, which stay.
.env
**/*.env

# Caches / build noise.
**/__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/
.DS_Store
